{
    "name": "arekx/array-expression-engine",
    "description": "Array Expression Engine Parser",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Aleksandar Panic",
            "email": "arekusanda1@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "ArekX\\ArrayExpression\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "scripts": {
        "test": "php vendor/bin/phpunit",
        "coverage": "php vendor/bin/phpunit --coverage-html coverage --coverage-filter src",
        "coverage-clover": "php vendor/bin/phpunit --coverage-clover coverage.xml --coverage-filter src"
    }
}
